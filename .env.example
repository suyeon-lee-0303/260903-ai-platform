# Claude API (required for ask / recommend)
# Put real secrets in .env or .env.local — never commit those files.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Local API server port (Vite proxies /api -> this)
API_PORT=3001

# Google Sheets (required for free-trial apply)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Or point to the JSON file (recommended). Keep this file gitignored.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SHEETS_ID=
# Optional. Default: Sheet1!A:H  (Korean sheets often use 시트1!A:H)
GOOGLE_SHEETS_RANGE=시트1!A:H
